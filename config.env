# ================================================================
# 24時間ラジオ配信システム 設定ファイル
# ================================================================
# このファイルでシステム全体の動作をカスタマイズできます
# 変更後は ./startup.sh restart で設定を反映してください

# ================================================================
# YouTube配信設定（必須 - 要変更）
# ================================================================

# YouTube Data API v3 キー
# 取得方法: https://console.developers.google.com でプロジェクト作成 → API有効化
YOUTUBE_API_KEY="YOUR_YOUTUBE_DATA_API_KEY"

# ライブ配信のビデオID
# YouTubeライブ配信URL: https://www.youtube.com/watch?v=[VIDEO_ID]
YOUTUBE_VIDEO_ID="YOUR_LIVE_VIDEO_ID"

# ライブ配信のストリームキー
# YouTube Studio → ライブ配信 → ストリームキーをコピー
YOUTUBE_STREAM_KEY="YOUR_YOUTUBE_STREAM_KEY"

# ================================================================
# LLM（言語モデル）設定
# ================================================================

# 使用するOllamaモデル名
OLLAMA_MODEL="gemma:1b"

# Ollama APIのベースURL（通常は変更不要）
OLLAMA_BASE_URL="http://localhost:11434"

# LLM応答の創造性レベル（0.0-1.0, 推奨: 0.7-0.8）
LLM_TEMPERATURE="0.7"

# LLM応答の最大トークン数（推奨: 150-250）
LLM_MAX_TOKENS="200"

# LLM応答のTop-pサンプリング（0.0-1.0, 推奨: 0.9）
LLM_TOP_P="0.9"

# 会話履歴の保持数（推奨: 5-15）
LLM_CONVERSATION_HISTORY="10"

# ================================================================
# VOICEVOX音声合成設定
# ================================================================

# VOICEVOX APIのベースURL（通常は変更不要）
VOICEVOX_BASE_URL="http://localhost:50021"

# デフォルトスピーカーID
# 1: 四国めたん（ノーマル）, 2: 四国めたん（あまあま）
# 3: ずんだもん（ノーマル）, 4: ずんだもん（あまあま）
VOICEVOX_SPEAKER_ID="1"

# VOICEVOXインストールディレクトリ
VOICEVOX_DIR="/opt/voicevox"

# 音声合成パラメータ
VOICEVOX_SPEED_SCALE="1.1"        # 話速（0.5-2.0, 推奨: 1.0-1.2）
VOICEVOX_PITCH_SCALE="0.05"       # 音高（-0.15-0.15, 推奨: 0.0-0.1）
VOICEVOX_INTONATION_SCALE="1.2"   # 抑揚（0.0-2.0, 推奨: 1.0-1.5）
VOICEVOX_VOLUME_SCALE="1.0"       # 音量（0.0-2.0, 推奨: 0.8-1.2）

# 音声キャッシュサイズ（メモリ節約: 50, 高速化: 200）
VOICEVOX_CACHE_SIZE="100"

# ================================================================
# OBS Studio配信設定
# ================================================================

# YouTube RTMP配信URL（通常は変更不要）
OBS_STREAM_URL="rtmp://a.rtmp.youtube.com/live2"

# 映像ビットレート（kbps, 推奨: 2000-4000）
OBS_VIDEO_BITRATE="2500"

# 音声ビットレート（kbps, 推奨: 128-320）
OBS_AUDIO_BITRATE="128"

# 映像解像度
OBS_VIDEO_WIDTH="1920"
OBS_VIDEO_HEIGHT="1080"

# フレームレート（推奨: 30）
OBS_FPS="30"

# 映像エンコーダー設定
OBS_ENCODER_PRESET="veryfast"     # ultrafast, superfast, veryfast, faster, fast, medium, slow
OBS_ENCODER_PROFILE="main"        # baseline, main, high
OBS_ENCODER_TUNE="zerolatency"    # film, animation, grain, stillimage, fastdecode, zerolatency

# ================================================================
# システム動作設定
# ================================================================

# ログレベル（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL="INFO"

# ログファイルの最大サイズ（MB）
MAX_LOG_SIZE="100"

# ログファイルの保持日数
LOG_RETENTION_DAYS="30"

# コメント取得間隔（秒, 推奨: 2-5）
COMMENT_FETCH_INTERVAL="2"

# 無反応時の自動発話間隔（秒, 推奨: 300-900）
IDLE_SPEAK_INTERVAL="600"

# システム監視間隔（秒, 推奨: 60-300）
MONITORING_INTERVAL="120"

# ================================================================
# 自動復旧・監視設定
# ================================================================

# 自動復旧機能有効化（true/false）
AUTO_RESTART="true"

# 復旧試行間隔（秒）
RECOVERY_INTERVAL="60"

# メモリ使用率警告閾値（%, 推奨: 80-90）
MEMORY_THRESHOLD="85"

# CPU使用率警告閾値（%, 推奨: 75-85）
CPU_THRESHOLD="80"

# ディスク使用率警告閾値（%, 推奨: 80-90）
DISK_THRESHOLD="85"

# 最大復旧試行回数（推奨: 3-10）
MAX_RESTART_ATTEMPTS="5"

# 復旧試行リセット時間（秒, 推奨: 3600-7200）
RESTART_RESET_TIME="3600"

# ================================================================
# 音声システム設定
# ================================================================

# 音声入力デバイス（通常は"default"のまま）
AUDIO_INPUT_DEVICE="default"

# 音声出力デバイス（通常は"default"のまま）
AUDIO_OUTPUT_DEVICE="default"

# PulseAudio自動設定（true/false）
PULSEAUDIO_AUTO_SETUP="true"

# システム停止時にVOICEVOXも停止するか（true/false）
STOP_VOICEVOX="false"

# ================================================================
# セキュリティ設定
# ================================================================

# APIアクセス制限（ローカルホストのみ: true, 外部アクセス許可: false）
RESTRICT_API_ACCESS="true"

# ログファイルの権限（推奨: 640）
LOG_FILE_PERMISSIONS="640"

# 設定ファイルの権限（推奨: 600）
CONFIG_FILE_PERMISSIONS="600"

# ================================================================
# 配信コンテンツ設定
# ================================================================

# 自動発話メッセージ（カンマ区切り）
IDLE_MESSAGES="こんにちは、皆さん！何かコメントをお待ちしています。,今日もいい一日ですね。何か話したいことはありますか？,音楽を聞きながら、のんびりとした時間を過ごしましょう。,皆さんからのコメントやスーパーチャット、お待ちしています！,何か気になることがあれば、お気軽にコメントしてくださいね。"

# スーパーチャット感謝メッセージテンプレート
SUPERCHAT_THANKS_TEMPLATE="{author}さん、{amount}{currency}のスーパーチャットありがとうございます！"

# コメント応答の最大長（文字数, 推奨: 100-300）
MAX_RESPONSE_LENGTH="200"

# 感情表現レベル（0.0-1.0, 推奨: 0.3-0.7）
EMOTION_LEVEL="0.5"

# ================================================================
# デバッグ・開発設定
# ================================================================

# デバッグモード有効化（true/false）
DEBUG_MODE="false"

# 詳細ログ出力（true/false）
VERBOSE_LOGGING="false"

# パフォーマンス測定（true/false）
PERFORMANCE_MONITORING="true"

# テストモード（true/false, 実際の配信を行わない）
TEST_MODE="false"

# ================================================================
# 高度な設定（上級者向け）
# ================================================================

# Python仮想環境パス（カスタム環境を使用する場合）
PYTHON_VENV_PATH=""

# カスタムPythonパス
PYTHON_PATH=""

# 環境変数の追加設定
CUSTOM_ENV_VARS=""

# プロセス優先度（-20から19, 推奨: 0から-5）
PROCESS_PRIORITY="0"

# CPU親和性設定（CPUコア指定, 例: "0,1"）
CPU_AFFINITY=""

# メモリ制限（MB, 0で無制限）
MEMORY_LIMIT="3000"

# ================================================================
# 外部連携設定（将来拡張用）
# ================================================================

# Discord Webhook URL（通知用）
DISCORD_WEBHOOK_URL=""

# Slack Webhook URL（通知用）
SLACK_WEBHOOK_URL=""

# Twitterボット設定
TWITTER_ENABLED="false"
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""

# データベース設定（統計記録用）
DATABASE_ENABLED="false"
DATABASE_URL=""

# ================================================================
# 注意事項・説明
# ================================================================

# 【重要】設定変更後の手順:
# 1. 設定を保存
# 2. ./startup.sh restart でシステム再起動
# 3. ./system_check.sh で動作確認

# 【推奨】バックアップ:
# - 定期的にこのファイルをバックアップしてください
# - cp config.env config.env.backup.$(date +%Y%m%d)

# 【トラブルシューティング】:
# - 設定に問題がある場合は、デフォルト値に戻してください
# - ログファイル（logs/main_app.log）で詳細を確認できます
# - ./system_check.sh で設定の妥当性を確認できます

# ================================================================
# 設定ファイル バージョン: 1.0
# 最終更新: 2025-01-28
# ================================================================
