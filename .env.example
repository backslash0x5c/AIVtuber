# ===== YouTube =====
# ライブ配信のビデオID (コメント取得に使用)
YOUTUBE_VIDEO_ID=
# YouTube Studio で発行される配信キー
YOUTUBE_STREAM_KEY=
YOUTUBE_RTMP_SERVER=rtmp://a.rtmp.youtube.com/live2

# ===== Ollama (ローカルLLM) =====
OLLAMA_URL=http://127.0.0.1:11434
# 注: ollamaに「gemma:1b」は存在しないため gemma3:1b を既定にしている
OLLAMA_MODEL=gemma3:1b
MAX_HISTORY=10

# ===== VOICEVOX =====
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=1
VOICEVOX_SPEED=1.0

# ===== OBS (obs-websocket) =====
OBS_ENABLED=true
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
# setup.sh が自動生成する。手動で設定してもよい
OBS_WS_PASSWORD=
# ブラウザソース(CEF=Chromium)のsandbox無効化。
#   auto(既定) = root実行時のみ --no-sandbox を付与 / true = 常に付与 / false = 付与しない
# root実行時に付けないとCEFの子プロセスが起動できずOBSごとクラッシュします
OBS_NO_SANDBOX=auto
# OBSへ渡す追加フラグ(スペース区切り)。CEFにもそのまま渡ります
# 例: ブラウザソースのGPUプロセスが落ちる場合 OBS_EXTRA_ARGS=--disable-gpu
OBS_EXTRA_ARGS=
# trueなら起動時に自動でYouTube配信を開始する
AUTO_START_STREAM=true

# ===== 映像 =====
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE_KBPS=2500
AUDIO_BITRATE_KBPS=128

# ===== 音声ミキシング =====
MIX_SINK=radio_mix
# 発話中のBGM音量(%)
BGM_DUCK_PERCENT=25
BGM_VOLUME_PERCENT=100

# ===== オーバーレイ(アバター) =====
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=8500
# Live2Dモデルを使う場合、avatar/ からの相対パスで .model3.json を指定
# 例: LIVE2D_MODEL=live2d/hiyori/hiyori.model3.json
LIVE2D_MODEL=

# ===== 挙動 =====
CHARACTER_NAME=ゆめ
# コメントが無い時に雑談を始めるまでの秒数
IDLE_CHAT_INTERVAL=180
# 通常コメントの最大待ち行列(超過分は間引く。スパチャは常に処理)
MAX_QUEUE=10
OPENING_MESSAGE=こんにちは、AIラジオ配信始まりました。コメント読み上げていくので、気軽に書き込んでくださいね。
